<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Кроссбраузерное тестирование" verbose="1" parallel="tests" thread-count="3">

    <test name="Chrome - UI Tests">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="zags.tests"/>
            <package name="zags.cucumber.runners"/>
        </packages>
    </test>
        <test name="Firefox - UI Tests">
            <parameter name="browser" value="firefox"/>
            <packages>
                <package name="zags.cucumber.runners"/>
            </packages>
        </test>
        <test name="Edge - UI Tests">
            <parameter name="browser" value="edge"/>
            <packages>
                <package name="zags.cucumber.runners"/>
            </packages>
        </test>
        <test name="API Tests">
            <packages>
                <package name="zags.apiTests"/>
            </packages>
        </test>
</suite>