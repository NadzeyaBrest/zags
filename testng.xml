<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="ZagsSuite" verbose="1">
    <listeners>
        <listener class-name="zags.data.TestListener"/>
    </listeners>
    <test name="Пользовательские сценарии">
        <groups>
            <run>
                <include name="user"/>
            </run>
        </groups>
        <packages>
            <package name="zags.tests"/>
            <package name="zags.apiTests"/>
        </packages>
    </test>
    <test name="Сценарии администратора">
        <groups>
            <run>
                <include name="admin"/>
            </run>
        </groups>
        <packages>
            <package name="zags.tests"/>
        </packages>
    </test>
    <test name="Кросс-ролевые сценарии">
        <groups>
            <run>
                <include name="crossRole"/>
            </run>
        </groups>
        <packages>
            <package name="zags.tests"/>
        </packages>
    </test>
    <test name="API-тесты">
        <groups>
            <run>
                <include name="API"/>
            </run>
        </groups>
        <packages>
            <package name="zags.apiTests"/>
        </packages>
    </test>


</suite>